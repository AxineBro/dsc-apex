# GigaChat
GIGA_CHAT_API_KEY=***
GIGA_CHAT_SCOPE=GIGACHAT_API_PERS
GIGA_CHAT_MODEL=GigaChat-Pro
GIGA_CHAT_UNSAFE_SSL=true

# База данных
DB_URL=jdbc:postgresql://postgres:5432/agentdb
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DDL_AUTO=update
DB_SHOW_SQL=true
DB_FORMAT_SQL=true

# Параметры приложения
APP_MAX_CYCLES=5
APP_BATCH_SIZE=5
APP_FLAT_LIMIT=5
APP_SLOW_THRESHOLD_MS=60000
APP_SLOW_SCORING_THRESHOLD_MS=20000
APP_TIMEOUT_REMINDER_WAIT_MINUTES=5
APP_TIMEOUT_SCHEDULER=10

# Пути к ресурсам
APP_DATA_APARTMENTS=data/apartments.json
APP_OFFER_TEMPLATE=templates/offer_template.txt
APP_SYSTEM_PROMPT=prompts/system_instruction.txt

# Логирование
LOG_LEVEL_SPRING_AI=DEBUG
LOG_LEVEL_GIGA=DEBUG
